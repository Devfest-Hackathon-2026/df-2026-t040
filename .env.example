# Vertex AI (billed to the GCP project; uses Application Default Credentials:
#   gcloud auth application-default login   — locally
#   the Cloud Run service account            — in production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: passcode staff must enter to create rooms (empty = open, local dev only)
STAFF_PASSCODE=
PORT=8787
# Models
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
ANALYSIS_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
TTS_FAST_MODEL=gemini-3.8-flash-lite-tts
# App-level spend guard (resets when the server restarts). The GCP spending cap is the hard stop.
# Live Translate ~ $0.037 per audio-minute per target language.
LIVE_MINUTES_LIMIT=180
ANALYSIS_CALLS_LIMIT=1500
TTS_CALLS_LIMIT=300
